@inherits LayoutComponentBase

<div class="public-theme"><ThemeToggle /></div>
<div class="public">
    <div class="public-side">
        <a class="brand brand-light" href="/login"><BrandMark /> <span>Sustain Monitor</span></a>
        <div class="public-pitch">
            <h2>Track green building work to the GBI standard.</h2>
            <p>Raise CO-tickets with evidence, get them approved, watch your GBI points and rating update, and earn an e-certificate for tenders.</p>
            <ul>
                <li>Official GBI criteria and rating bands</li>
                <li>Project Manager, Superior and CEO roles</li>
                <li>Verifiable e-certificate with QR code</li>
            </ul>
        </div>
        <div class="public-foot">GBI-aligned self-assessment. Not an official Green Building Index certification.</div>
    </div>
    <div class="public-main">
        <div class="public-card">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
