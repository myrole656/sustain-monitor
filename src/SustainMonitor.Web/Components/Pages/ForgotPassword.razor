@page "/forgot-password"
@layout PublicLayout
@inject ApiClient Api

<PageTitle>Reset password · Sustain Monitor</PageTitle>

<h1>Reset your password</h1>

@if (!_codeSent)
{
    <p class="lead">Enter your email. If it has an account, we'll send a reset code.</p>
    <Alert Text="@_error" />
    <form class="form" @onsubmit="SendCodeAsync" @onsubmit:preventDefault>
        <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" @bind="_email" required />
        </div>
        <div class="row-between">
            <a href="/login">Back to sign in</a>
            <button class="btn" type="submit" disabled="@_busy">Send reset code</button>
        </div>
    </form>
}
else if (!_reset)
{
    <p class="lead">Check <b>@_email</b> for the code, then choose a new password.</p>
    <Alert Text="@_error" />
    <form class="form" @onsubmit="ResetAsync" @onsubmit:preventDefault>
        <div class="field">
            <label for="code">Reset code</label>
            <input id="code" @bind="_code" required />
        </div>
        <div class="field">
            <label for="pw">New password</label>
            <input id="pw" type="password" autocomplete="new-password" @bind="_password" required />
            <span class="hint">10+ characters with upper case, lower case and a number</span>
        </div>
        <div class="row-between">
            <button class="btn-link" type="button" @onclick="() => _codeSent = false">Use a different email</button>
            <button class="btn" type="submit" disabled="@_busy">Set new password</button>
        </div>
    </form>
}
else
{
    <Alert Kind="success" Text="Password changed. You can sign in now." />
    <a class="btn" href="/login">Sign in</a>
}

@code {
    private string _email = "", _code = "", _password = "";
    private bool _codeSent, _reset, _busy;
    private string? _error;

    private async Task SendCodeAsync()
    {
        _error = null; _busy = true;
        try
        {
            var r = await Api.AnonymousPostAsync<object>("api/auth/forgotPassword", new { email = _email.Trim() });
            if (r.Ok) _codeSent = true; else _error = r.Error;
        }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        _error = null; _busy = true;
        try
        {
            var r = await Api.AnonymousPostAsync<object>("api/auth/resetPassword",
                new { email = _email.Trim(), resetCode = _code.Trim(), newPassword = _password });
            if (r.Ok) _reset = true; else _error = r.Error ?? "The code is wrong or has expired.";
        }
        finally { _busy = false; }
    }
}
