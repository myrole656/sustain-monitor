@page "/account/password"
@inject ApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Change password · Sustain Monitor</PageTitle>

<div style="max-width:520px">
    <div class="page-head">
        <div>
            <h1>@(First ? "Choose your password" : "Change password")</h1>
            @if (First)
            {
                <p>You signed in with a temporary password. Choose your own before you continue.</p>
            }
        </div>
    </div>

    <div class="card">
        <Alert Text="@_error" />
        <Alert Kind="success" Text="@_ok" />
        <form class="form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="cur">@(First ? "Temporary password" : "Current password")</label>
                <input id="cur" type="password" autocomplete="current-password" @bind="_current" required />
            </div>
            <div class="field">
                <label for="new">New password</label>
                <input id="new" type="password" autocomplete="new-password" @bind="_new" required />
                <span class="hint">10+ characters with upper case, lower case and a number</span>
            </div>
            <div class="field">
                <label for="new2">Confirm new password</label>
                <input id="new2" type="password" autocomplete="new-password" @bind="_confirm" required />
            </div>
            <div class="right">
                <button class="btn" type="submit" disabled="@_busy">Save password</button>
            </div>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "first")] public int? FirstFlag { get; set; }
    private bool First => FirstFlag == 1 || Session.Me?.MustChangePassword == true;

    private string _current = "", _new = "", _confirm = "";
    private string? _error, _ok;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = _ok = null;
        if (_new != _confirm) { _error = "New passwords do not match."; return; }
        _busy = true;
        try
        {
            var r = await Api.PostAsync("api/auth/change-password", new { currentPassword = _current, newPassword = _new });
            if (!r.Ok) { _error = r.Error; return; }
            await Api.RefreshMeAsync();
            _current = _new = _confirm = "";
            if (First) Nav.NavigateTo("/"); else _ok = "Password changed.";
        }
        finally { _busy = false; }
    }
}
