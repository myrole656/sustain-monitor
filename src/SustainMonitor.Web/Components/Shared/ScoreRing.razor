@* Circular GBI score: solid arc = confirmed/awarded, faint arc = target or projected. *@
<div class="ring" role="img" aria-label="@($"{Value} of 100 points, {Rating}")">
    <svg viewBox="0 0 120 120">
        <defs>
            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--neon-a)" />
                <stop offset="100%" stop-color="var(--neon-b)" />
            </linearGradient>
        </defs>
        <circle class="ring-bg" cx="60" cy="60" r="@R" />
        @if (Target is > 0)
        {
            <circle class="ring-target" cx="60" cy="60" r="@R" stroke-dasharray="@Dash(Target.Value)" />
        }
        @if (Value > 0)
        {
            <circle class="ring-value" cx="60" cy="60" r="@R" stroke="url(#ringGrad)" stroke-dasharray="@Dash(Value)" />
        }
    </svg>
    <div class="ring-center">
        <b>@Value</b>
        <small>/ 100</small>
        <RatingBadge Rating="@Rating" />
    </div>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public int? Target { get; set; }
    [Parameter] public string? Rating { get; set; }

    private const double R = 52;
    private static readonly double C = 2 * Math.PI * R;

    private static string Dash(int points)
    {
        var len = C * Math.Clamp(points, 0, 100) / 100.0;
        return FormattableString.Invariant($"{len:0.##} {C:0.##}");
    }
}
