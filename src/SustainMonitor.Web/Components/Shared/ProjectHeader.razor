<div class="crumbs"><a href="/projects">Projects</a> / @Project.Code</div>
<div class="page-head">
    <div>
        <div class="row">
            <h1>@Project.Name</h1>
            <RatingBadge Rating="@Project.Current?.Rating" />
        </div>
        <p>GBI @Project.Tool.Code v@(Project.Tool.Version) · @(Project.Location ?? "—") · Target @(Project.TargetRating ?? "—")</p>
    </div>
    <div class="row">
        @ChildContent
    </div>
</div>
<div class="tabs mb-2" role="tablist">
    <a class="btn btn-sm @(Active == "overview" ? "" : "btn-ghost")" href="/projects/@Project.Id"><Icon Name="chart" /> Overview</a>
    <a class="btn btn-sm @(Active == "board" ? "" : "btn-ghost")" href="/projects/@Project.Id/board"><Icon Name="board" /> CO-ticket board</a>
    <a class="btn btn-sm @(Active == "lifecycle" ? "" : "btn-ghost")" href="/projects/@Project.Id/lifecycle"><Icon Name="leaf" /> Lifecycle</a>
    @if (Project.Current is null && Project.MyRole == CompanyRole.ProjectManager)
    {
        <a class="btn btn-sm @(Active == "baseline" ? "" : "btn-ghost")" href="/projects/@Project.Id/baseline"><Icon Name="check" /> Baseline</a>
    }
</div>

@code {
    [Parameter, EditorRequired] public ProjectDetail Project { get; set; } = default!;
    [Parameter] public string Active { get; set; } = "overview";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
