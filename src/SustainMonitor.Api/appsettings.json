{
  "ConnectionStrings": {
    "Default": "Data Source=sustainmonitor.db"
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Analysis": {
    "ProgressThreshold": 0.8
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "PublicPerMinute": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "EvidenceFolder": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "no-reply@sustainmonitor.local",
    "FromName": "Sustain Monitor"
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
