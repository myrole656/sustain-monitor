# Copy to .env and fill in. Never commit .env.

# Public address of the site (DNS must point here). Caddy gets the HTTPS certificate automatically.
DOMAIN=sustainmonitor.example.com
ACME_EMAIL=it@example.com

# First platform admin, created on first start. Remove the password from this file after the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis2026Now

# Email (leave SMTP_HOST empty to only log emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Business settings
PROGRESS_THRESHOLD=0.8
ACCESS_TOKEN_MINUTES=60

# Optional: use prebuilt images from CI, e.g. ghcr.io/your-org/sustainmonitor
IMAGE_PREFIX=sustainmonitor
IMAGE_TAG=latest
